 /* 
  * Callback from ioqueue when asynchronous connect() operation completes.
+ */
+/* android-voice-sip-agent: RFC 6125 section 6.4.3 host name matching. A "*." wildcard in the
+ * left-most label matches exactly one label of a DNS name, as browsers and most SIP clients do;
+ * RFC 5922 forbids wildcards, but public CAs commonly issue only those. IP addresses never match
+ * a wildcard.
  */
+static pj_bool_t tls_host_match(const pj_str_t *remote, const pj_str_t *cert_name)
+{
+    char *dot;
+    pj_str_t rest, suffix;
+
+    if (!pj_stricmp(remote, cert_name))
+        return PJ_TRUE;
+    if (cert_name->slen < 3 || cert_name->ptr[0] != '*' || cert_name->ptr[1] != '.')
+        return PJ_FALSE;
+    dot = (char*)pj_memchr(remote->ptr, '.', remote->slen);
+    if (!dot || dot == remote->ptr)
+        return PJ_FALSE;
+    pj_strset(&rest, dot, remote->slen - (dot - remote->ptr));
+    pj_strset(&suffix, cert_name->ptr + 1, cert_name->slen - 1);
+    return !pj_stricmp(&rest, &suffix);
+}
